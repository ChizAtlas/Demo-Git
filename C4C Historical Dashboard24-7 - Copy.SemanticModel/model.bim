          }
        ],
        "lineageTag": "2a61d1ab-673d-4dc7-81ad-0f2237d5c20e",
        "partitions": [
          {
            "name": "RLS Table-c9934424-92d3-40b1-b98b-f488976eb922",
            "mode": "import",
            "queryGroup": "3_Result Tables",
            "source": {
              "expression": [
                "let",
                "  Source = SharePoint.Contents(\"https://onevirtualoffice.sharepoint.com/sites/bd3f1f870ace457b80c0202621b39b9d/\", [ApiVersion = 15]),",
                "  Navigation = Source{[Name = \"C4C SPLIT\"]}[Content],",
                "  #\"Navigation 1\" = Navigation{[Name = \"2. Realization\"]}[Content],",
                "  #\"Navigation 2\" = #\"Navigation 1\"{[Name = \"2.2 Data exports\"]}[Content],",
                "  #\"Navigation 3\" = #\"Navigation 2\"{[Name = \"PT\"]}[Content],",
                "  #\"Navigation 4\" = #\"Navigation 3\"{[Name = \"PRODUCTION\"]}[Content],",
                "  #\"Removed other columns\" = Table.SelectColumns(#\"Navigation 4\", {\"Content\", \"Name\"}),",
                "  #\"Filtered rows\" = Table.SelectRows(#\"Removed other columns\", each [Name] = \"Row-Level-Security\"),",
                "  #\"Expanded Content\" = Table.ExpandTableColumn(#\"Filtered rows\", \"Content\", {\"Content\", \"Name\"}, {\"Content.1\", \"Name.1\"}),",
                "  #\"Navigation 5\" = #\"Expanded Content\"{1}[Content.1],",
                "  #\"Imported Excel workbook\" = Excel.Workbook(#\"Navigation 5\", null, true),",
                "  #\"Navigation 6\" = #\"Imported Excel workbook\"{[Item = \"Sheet1\", Kind = \"Sheet\"]}[Data],",
                "  #\"Changed column type\" = Table.TransformColumnTypes(#\"Navigation 6\", {{\"Column1\", type text}, {\"Column2\", type text}}),",
                "  #\"Promoted headers\" = Table.PromoteHeaders(#\"Changed column type\", [PromoteAllScalars = true]),",
                "  #\"Removed other columns 1\" = Table.SelectColumns(#\"Promoted headers\", {\"Access to SalesOrgs\", \"User email\"}),",
                "  #\"Trimmed text\" = Table.TransformColumns(#\"Removed other columns 1\", {{\"Access to SalesOrgs\", each Text.Trim(_), type nullable text}})",
                "in",
                "    #\"Trimmed text\""
              ],
              "type": "m"
            }
          }
        ]
      },
