          {
            "name": "Check_Duplicated Activity Id",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "expression": [
              "",
              "IF(FACT_Attachments[SalesOrg] = FACT_Attachments[Sales_Organization_ID] ,1 ,0)"
            ],
            "formatString": "0",
            "isDataTypeInferred": true,
            "lineageTag": "3ba99a25-e466-468c-93df-82321cc89e16",
            "summarizeBy": "count",
            "type": "calculated"
          },
          {
            "name": "SalesOrgTCorrect",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "IF(ISBLANK(FACT_Attachments[SalesOrg]), FACT_Attachments[Sales_Organization_ID], FACT_Attachments[SalesOrg])"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "5cd5b8dd-d715-45b3-bad5-177337ae715e",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "SO ALL",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "",
              "IF(CONTAINSSTRING(FACT_Attachments[Account_ID], \"ARO\"), \"US20\", ",
              "    IF(CONTAINSSTRING(FACT_Attachments[Account_ID], \"BQF\"), \"BQF\",",
              "        FACT_Attachments[SalesOrgTCorrect]",
              ")",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "30fbd325-0c45-48ee-b606-aefc11780049",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Sales_Or_Id_Final",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "VAR ACCID = FACT_Attachments[Account_ID]",
              "VAR _Almost =",
              "CALCULATE(",
              "    FIRSTNONBLANK(",
              "        VALUES('STG BridgeAccountsSalesOrganizations'[Sales_Organization_ID]),1),",
              "        ACCID = 'STG BridgeAccountsSalesOrganizations'[Account_ID]",
              ")",
              "",
              "Return",
              "IF(",
              "    ISBLANK(_Almost),",
              "    FACT_Attachments[SO ALL],",
              "_Almost",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "dcd74588-9abf-4c81-ba2a-6295131c0372",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
        "lineageTag": "d338e6c3-f322-4469-b25a-49c400e98c35",
        "measures": [
          {
            "name": "Countrows FACT Attachments",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNTROWS(FACT_Attachments))"
            ],
            "formatString": "0",
