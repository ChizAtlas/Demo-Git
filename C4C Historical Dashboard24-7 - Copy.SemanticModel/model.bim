        "partitions": [
          {
            "name": "STG_Attachments_ALL",
            "mode": "import",
            "queryGroup": "3_Result Tables",
            "source": {
              "expression": [
                "let",
                "  Source = STG_Attachments_1,",
                "    ",
                "    #\"Appended Query\" = Table.Combine({#\"Source\", STG_Attachments_NA}),",
                "",
                "    #\"Appended Query1\" = Table.Combine({#\"Appended Query\", STG_Attachments_EU}),",
                "",
                "    ////#\"Removed Columns3\" = Table.RemoveColumns(#\"Appended Query1\",{\"SalesOrg\", \"Name\"}),",
                "   ",
                "    #\"Appended Query2\" = Table.Combine({#\"Appended Query1\", STG_Attachments_Others}),",
                "    #\"Appended Query3\" = Table.Combine({#\"Appended Query2\", #\"OLD ID'S For Attachments EE\"}),",
                "",
                "    #\"Removed Columns3\" = Table.RemoveColumns(#\"Appended Query3\",{\"Name\"}),",
                "",
                "    #\"Replaced Value\" = Table.ReplaceValue(#\"Removed Columns3\",\"SalesQuotes Part 1\",\"SalesQuotes\",Replacer.ReplaceText,{\"Object\"}),",
                "    #\"Replaced Value1\" = Table.ReplaceValue(#\"Replaced Value\",\"SalesQuotes Part 2\",\"SalesQuotes\",Replacer.ReplaceText,{\"Object\"}),",
                "    #\"Replaced Value2\" = Table.ReplaceValue(#\"Replaced Value1\",\"SalesQuotes Part1\",\"SalesQuotes\",Replacer.ReplaceText,{\"Object\"}),",
                "    #\"Replaced Value3\" = Table.ReplaceValue(#\"Replaced Value2\",\"1 Emails\",\"Emails\",Replacer.ReplaceText,{\"Object\"}),",
                "    #\"Replaced Value4\" = Table.ReplaceValue(#\"Replaced Value3\",\"2 Emails\",\"Emails\",Replacer.ReplaceText,{\"Object\"}),",
                "    #\"Replaced Value6\" = Table.ReplaceValue(#\"Replaced Value4\",\"4 Emails\",\"Emails\",Replacer.ReplaceText,{\"Object\"}),",
                "    #\"Replaced Value5\" = Table.ReplaceValue(#\"Replaced Value6\",\"3 Emails\",\"Emails\",Replacer.ReplaceText,{\"Object\"}),",
                "    #\"Replaced Value7\" = Table.ReplaceValue(#\"Replaced Value5\",\"5 Emails\",\"Emails\",Replacer.ReplaceText,{\"Object\"}),",
                "    #\"Replaced Value8\" = Table.ReplaceValue(#\"Replaced Value7\",\"6 Emails\",\"Emails\",Replacer.ReplaceText,{\"Object\"}),",
                "    #\"Replaced Value9\" = Table.ReplaceValue(#\"Replaced Value8\",\"7 Emails\",\"Emails\",Replacer.ReplaceText,{\"Object\"}),",
                "    #\"Replaced Value10\" = Table.ReplaceValue(#\"Replaced Value9\",\"1 SalesQuotes\",\"SalesQuotes\",Replacer.ReplaceText,{\"Object\"}),",
                "    #\"Added Index\" = Table.AddIndexColumn(#\"Replaced Value10\", \"Index\", 0, 1, Int64.Type),",
                "    #\"Duplicated Column1\" = Table.DuplicateColumn(#\"Added Index\", \"ID\", \"ID_Text\"),",
                "    #\"Changed Type1\" = Table.TransformColumnTypes(#\"Duplicated Column1\",{{\"ID\", Int64.Type}}),",
                "",
                "    ////#\"Filtered Rows1\" = Table.SelectRows(#\"Changed Type1\", each ([Object] <> \"Customers\" and [Object] <> \"Prospects\")),",
                "    ",
                "    #\"Filtered Rows1\" = Table.SelectRows(#\"Changed Type1\", each ( [Object] <> \"Prospects\")),",
                "",
                "    #\"Renamed Columns2\" = Table.RenameColumns(#\"Filtered Rows1\",{{\"Index\", \"Attachment ID\"}}),",
                "",
                "    #\"Mark Non Numeric IDs\" = Table.AddColumn(#\"Renamed Columns2\", \"ID_Text2\", each",
                "      if Type.Is(Value.Type([ID_Text]), type number) then [ID_Text]",
                "      else if Text.Contains(Text.Trim([ID_Text]), \" \") then \"DELETE\"",
                "      else try Number.From([ID_Text]) otherwise \"DELETE\"",
                "    ),",
                "",
                "    #\"Filtered Rows2\" = Table.SelectRows(#\"Mark Non Numeric IDs\", each ( [ID_Text2] <> \"DELETE\")),",
                "",
                "    #\"Removed Column4\" = Table.RemoveColumns(#\"Filtered Rows2\",{\"ID_Text2\"})",
                "",
                "in",
                "    #\"Removed Column4\""
              ],
              "type": "m"
            }
          }
        ]
