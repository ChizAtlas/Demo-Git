          "  #\"Filtered rows 4\" = Table.SelectRows(#\"Expanded Extracted tables\", each ([Reference_Document_Type_Code_Text] = \"Opportunity\")),",
          "  #\"Renamed columns\" = Table.RenameColumns(#\"Filtered rows 4\", {{\"Reference_Document_ID\", \"Opportunity_ID\"}}),",
