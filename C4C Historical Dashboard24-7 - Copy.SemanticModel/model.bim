              "",
              "\"Description: \"         & [Description]             & unichar(13) & unichar(10) &",
              "\"Document Type: \"       & [Document_Type_Text]      & unichar(13) & unichar(10) &",
              "\"Account Name: \"        & [Account_Name]            & unichar(13) & unichar(10) &",
              "\"Contact Name: \"        & [Primary_Contact_Name]    & unichar(13) & unichar(10) &",
              "\"Owner Name: \"          & [Owner_Name]              & unichar(13) & unichar(10) &",
              "\"Sales Organization: \"  & [Sales_Organization_ID]   & unichar(13) & unichar(10) &",
              "\"Valid From: \"          & [Valid_From]              & unichar(13) & unichar(10) &",
              "\"Net Total: \"           & [Net_Total]               & unichar(13) & unichar(10) &",
              "\"Currency: \"            & [Currency]                & unichar(13) & unichar(10) &",
              "\"Status: \"              & [Status_Text]             & unichar(13) & unichar(10) "
            ],
