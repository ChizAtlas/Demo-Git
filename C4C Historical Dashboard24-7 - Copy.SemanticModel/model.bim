            "dataType": "string",
            "expression": [
              "",
              "var _Rest = FACT_Activities[Document_Type_Text]",
              "var _Correct = LOOKUPVALUE('Campaings_Tasks (2)'[Document_Type_Text] , 'Campaings_Tasks (2)'[Task ID] , FACT_Activities[ID_Text])",
              "",
              "Return",
              "IF( ISBLANK(_Correct), _Rest, _Correct)"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "42fe22fa-9be7-4c05-a99c-4c927245ac82",
