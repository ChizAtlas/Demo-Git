          {
            "name": "Basic Info",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "\"Name: \"                & [Name]                 & unichar(13) & unichar(10) &",
              "\"Source: \"              & [Source_Text]          & unichar(13) & unichar(10) &",
              "\"Status: \"              & [Status_Text]          & unichar(13) & unichar(10) &",
              "\"Expected Value: \"      & [Expected_Value]       & unichar(13) & unichar(10) &",
              "\"Currency: \"            & [Currency]             & unichar(13) & unichar(10) &",
              "\"Start Date: \"          & [Start_Date]           & unichar(13) & unichar(10) &",
              "\"Sales Organization: \"  & [Sales_Organization]   & unichar(13) & unichar(10) &",
              "\"Owner Name: \"          & [Owner_Name]           & unichar(13) & unichar(10) &",
              "\"Contact Name: \"        & [Primary_Contact_Nme]  & unichar(13) & unichar(10) &",
              "\"Business Line: \"       & [Business_Line]        & unichar(13) & unichar(10) &",
              "\"Prospect Party: \"      & [Prospect_Party_Name]  & unichar(13) & unichar(10) ",
              ""
            ],
            "isDataTypeInferred": true,
            "lineageTag": "deb26a9e-fb39-40c8-aded-49914d3b496d",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
        "lineageTag": "a3fa2cea-5e9d-41a4-8b16-3149ffb5a7c1",
        "measures": [
          {
            "name": "SelectedOppID",
            "expression": [
              "",
              "If(",
              "    HasOneValue(FACT_Opportunities[Opportunity_ID]) ",
