            "dataType": "string",
            "expression": [
              "",
              "",
              "\"Contact Person: \"      & [Main_Contact_Person_Name]    & unichar(13) & unichar(10) &",
              "\"Company: \"             & [Account_Party_Name]          & unichar(13) & unichar(10) &",
              "\"Status: \"              & [Status_Text]                 & unichar(13) & unichar(10) &",
              "\"Source: \"              & [Source_Text]                 & unichar(13) & unichar(10) &",
              "\"Start Date: \"          & [Start_Date]                  & unichar(13) & unichar(10) &",
              "\"Campaign: \"            & [Campaign_ID]                 & unichar(13) & unichar(10) &",
              "\"Sales Owner: \"         & [Owner_Party_Name]            & unichar(13) & unichar(10) &",
              "\"Sales Organization: \"  & [Sales_Organization_ID]       & unichar(13) & unichar(10) &",
              "\"Customer Country: \"    & [Customer_Information_Country_Text] & unichar(13) & unichar(10) &",
              "\"Business Line: \"       & [Business_Line]               & unichar(13) & unichar(10) ",
              "",
              ""
            ],
