            "mode": "import",
            "queryGroup": "3_Result Tables",
            "source": {
              "expression": [
                "let",
                "  Source = #\"STG DIM Leads\",",
                "  #\"Appended query\" = Table.Combine({Source, #\"STG DIM SalesQuotes\", #\"STG DIM Opportunities\"}),",
                "  #\"Appended query 1\" = Table.Combine({#\"Appended query\", #\"STG DIM Activities Merged\"}),",
                "    #\"Trimmed Text\" = Table.TransformColumns(#\"Appended query 1\",{{\"Sales_Organization_ID\", Text.Trim, type text}}),",
                "  #\"Merged queries\" = Table.NestedJoin(#\"Trimmed Text\", {\"Campaign_ID\"}, #\"STG DIM Campaign\", {\"Campaign_ID\"}, \"STG DIM Campaign\", JoinKind.LeftOuter),",
                "  #\"Expanded STG DIM Campaign\" = Table.ExpandTableColumn(#\"Merged queries\", \"STG DIM Campaign\", {\"Campaign ID / Description\"}, {\"Campaign ID / Description\"}),",
                "  #\"Removed duplicates\" = Table.Distinct(#\"Expanded STG DIM Campaign\"),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Removed duplicates\",{{\"Start_Date\", type date}}),",
                "    #\"Filtered Rows\" = Table.SelectRows(#\"Changed Type\", each ([Account_ID] <> \"AE30\" and [Account_ID] <> \"SBA\" and [Account_ID] <> \"ZAX\" and [Account_ID] <> \"BQF\"  and [Account_ID] <> \"BE40\" and [Account_ID] <> \"GB10\" and [Account_ID] <> \"GBC\" and [Account_ID] <> \"SBA\" and [Account_ID] <> \"CL20\" and [Account_ID] <> \"CQF\" and [Account_ID] <> \"FRC0\" and [Account_ID] <> \"DE20\" and [Account_ID] <> \"ES20\" and [Account_ID] <> \"PE20\" and [Account_ID] <> \"SG20\" and [Account_ID] <> \"PH10\" and [Account_ID] <> \"TH10\" and [Account_ID] <> \"IN30\" and [Account_ID] <> \"IT40\" and [Account_ID] <> \"MX20\" and [Account_ID] <> \"RO20\" and [Account_ID] <> \"RU40\" and [Account_ID] <> \"US20\"))",
                "in",
                "    #\"Filtered Rows\""
              ],
              "type": "m"
            }
          }
        ]
