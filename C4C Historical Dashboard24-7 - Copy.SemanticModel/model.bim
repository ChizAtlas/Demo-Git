          {
            "name": "#CountPerActivityID",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "expression": [
              "",
              "calculate(",
              "    countrows(FACT_ALL),",
              "    ALLEXCEPT(FACT_ALL, FACT_ALL[Activity_ID])",
              ")"
            ],
            "formatString": "0",
            "isDataTypeInferred": true,
            "lineageTag": "dc2566b4-4868-4118-9428-ac6bc80cdca8",
            "summarizeBy": "count",
            "type": "calculated"
          },
          {
            "name": "Sales_Org_ID",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "",
              "VAR _SOActivity =  LOOKUPVALUE('Campaings_Tasks (2)'[Sales Organization],'Campaings_Tasks (2)'[Task ID],FACT_ALL[Activity_ID])",
              "Return",
              "IF(",
              "    ISBLANK(",
              "        FACT_ALL[Sales_Organization_ID]),",
              "         _SOActivity,FACT_ALL[Sales_Organization_ID]",
              ")"
            ],
            "isDataTypeInferred": true,
            "isHidden": true,
            "lineageTag": "0e2edee6-45be-4cb6-a2d2-5321f36e5ca8",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "SO ALL",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "VAR ACCID = FACT_ALL[Account_ID]",
              "Return",
              "CALCULATE(",
              "    FIRSTNONBLANK(",
              "        VALUES('STG BridgeAccountsSalesOrganizations'[Sales_Organization_ID]),1),",
              "        ACCID = 'STG BridgeAccountsSalesOrganizations'[Account_ID]",
              ")"
            ],
            "isDataTypeInferred": true,
            "isHidden": true,
            "lineageTag": "12c178cd-cf5d-4ef6-ace0-fff587825e3f",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "SalesOrgCorrect ALL",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "IF(",
              "    ISBLANK(",
              "        FACT_ALL[Sales_Org_ID]),",
              "        FACT_ALL[SO ALL],",
              "        FACT_ALL[Sales_Org_ID]",
              ")"
            ],
            "isDataTypeInferred": true,
            "isHidden": true,
            "lineageTag": "8a1a4d64-d663-4da3-aa67-ebe84eece746",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Campaign ID / Description Full",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "VAR _AllCampaign = LOOKUPVALUE(DIM_Campaigns[Campaign ID / Description] , DIM_Campaigns[Campaign_ID] , FACT_ALL[Campaign_ID])",
              "",
              "Return",
              "_AllCampaign"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "3d2b6d60-3bc3-4a69-aec6-9319afe35c3f",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Sales_Org_Final",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "VAR _OtherSO = FACT_ALL[SalesOrgCorrect ALL]",
              "",
              "Return",
              "IF(",
              "    CONTAINSSTRING(FACT_ALL[Account_ID], \"ARO\" ), \"US20\", ",
              "     IF(CONTAINSSTRING(FACT_ALL[Account_ID],\"BQF\"), \"BQF\",_OtherSO)",
              ")"
            ],
            "isDataTypeInferred": true,
            "isHidden": true,
            "lineageTag": "e7e40fb3-3db6-4f53-8453-e86a91d0caf4",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Sales_Org_Final_Complete",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "var _Almost = FACT_ALL[Sales_Org_Final]",
              "var _Complete = LOOKUPVALUE(Account_Sales_Data[Sales_Organization_ID], Account_Sales_Data[Account_ID],FACT_ALL[Account_ID])",
              "Return",
              "IF(",
              "    ISBLANK(_Complete),_Almost, _Complete)"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "deac21cd-af6e-430f-a7e8-93e3a15c3230",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
