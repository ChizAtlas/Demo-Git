          {
            "name": "STG_Attachments_EU",
            "mode": "import",
            "queryGroup": "3_Result Tables",
            "source": {
              "expression": [
                "let",
                "  Source = SharePoint.Contents(\"https://onevirtualoffice.sharepoint.com/sites/bd3f1f870ace457b80c0202621b39b9d/\" , [ApiVersion = 15]),",
                "  Navigation = Source{[Name = \"C4C SPLIT\"]}[Content],",
                "  #\"Navigation 1\" = Navigation{[Name = \"2. Realization\"]}[Content],",
                "  #\"Navigation 2\" = #\"Navigation 1\"{[Name = \"2.2 Data exports\"]}[Content],",
                "  #\"Navigation 3\" = #\"Navigation 2\"{[Name = \"PT\"]}[Content],",
                "  #\"Navigation 4\" = #\"Navigation 3\"{[Name = \"PRODUCTION\"]}[Content],",
                "  #\"Removed other columns\" = Table.SelectColumns(#\"Navigation 4\", {\"Content\", \"Name\"}),",
                "  ",
                "  #\"Filtered Rows1\" = Table.SelectRows(#\"Removed other columns\", each [Name] = \"DE20\" or [Name] = \"AT30\" or [Name] = \"BE40\" or [Name] = \"CH30\" or [Name] = \"ES20+PT20+IT40\" or [Name] = \"FRC0\" or [Name] = \"GB30(GBC)\" or [Name] = \"KZ20\" or [Name] = \"SBA\"),",
                "  ",
                "    #\"Expanded Content\" = Table.ExpandTableColumn(#\"Filtered Rows1\", \"Content\", {\"Content\", \"Name\"}, {\"Content.1\", \"Name.1\"}),",
                "  #\"Filtered rows 1\" = Table.SelectRows(#\"Expanded Content\", each ([Name.1] = \"8 (1). ATTACHMENTS\" or [Name.1] = \"8. ATTACHMENTS\" or [Name.1] = \"8. Attachments\")),",
                "  #\"Removed columns\" = Table.RemoveColumns(#\"Filtered rows 1\", {\"Name.1\", \"Name\"}),",
                "  #\"Expanded Content.1\" = Table.ExpandTableColumn(#\"Removed columns\", \"Content.1\", {\"Content\", \"Folder Path\", \"Name\"}, {\"Content\", \"Folder Path\", \"Name\"}),",
                "  #\"Filtered rows 4\" = Table.SelectRows(#\"Expanded Content.1\", each [Name] <> \"ACPT_ATTACHMENTS_NamingConvention.png\"),",
                "  #\"Filtered rows 5\" = Table.SelectRows(#\"Filtered rows 4\", each not Text.EndsWith([Name], \".zip\")),",
                "    #\"Added Custom1\" = Table.AddColumn(#\"Filtered rows 5\", \"Full Path\", each [Folder Path] & [Name]),",
                "    #\"Filtered Rows\" = Table.SelectRows(#\"Added Custom1\", each ([Full Path] <> \"https://onevirtualoffice.sharepoint.com/sites/bd3f1f870ace457b80c0202621b39b9d/C4C SPLIT/2. Realization/2.2 Data exports/PT/PRODUCTION/ES20+PT20+IT40/8. ATTACHMENTS/6. Emails\")),",
                "    #\"Removed Columns4\" = Table.RemoveColumns(#\"Filtered Rows\",{\"Folder Path\"}),",
                "    #\"Expanded Content 2\" = Table.ExpandTableColumn(#\"Removed Columns4\", \"Content\", {\"Content\", \"Name\", \"Extension\", \"Attributes\", \"Folder Path\"}, {\"Content.1\", \"Name.3\", \"Extension\", \"Attributes\", \"Folder Path\"}),",
                "    #\"Split Column by Delimiter\" = Table.SplitColumn(#\"Expanded Content 2\", \"Name.3\", Splitter.SplitTextByEachDelimiter({\"-\"}, QuoteStyle.Csv), {\"Name.1\", \"Name.2\"}),",
                "    #\"Filtered Rows2\" = Table.SelectRows(#\"Split Column by Delimiter\", each ([Extension] <> null and [Extension] <> \"\" and [Extension] <> \".zip\")),",
                "  #\"Renamed Columns\" = Table.RenameColumns(#\"Filtered Rows2\", {{\"Name.1\", \"ID\"}, {\"Name.2\", \"Description\"}, {\"Folder Path\", \"URL\"}}),",
                "  #\"Duplicated Column\" = Table.DuplicateColumn(#\"Renamed Columns\", \"URL\", \"URL - Copy\"),",
                "  #\"Split Column by Delimiter1\" = Table.SplitColumn(#\"Duplicated Column\", \"URL - Copy\", Splitter.SplitTextByEachDelimiter({\"/\"}, QuoteStyle.Csv, true), {\"URL - Copy.1\", \"URL - Copy.2\"}),",
                "  #\"Split Column by Delimiter2\" = Table.SplitColumn(#\"Split Column by Delimiter1\", \"URL - Copy.1\", Splitter.SplitTextByEachDelimiter({\"/\"}, QuoteStyle.Csv, true), {\"URL - Copy.1.1\", \"URL - Copy.1.2\"}),",
                "  #\"Split Column by Delimiter3\" = Table.SplitColumn(#\"Split Column by Delimiter2\", \"URL - Copy.1.1\", Splitter.SplitTextByEachDelimiter({\"/\"}, QuoteStyle.Csv, true), {\"URL - Copy.1.1.1\", \"URL - Copy.1.1.2\"}),",
                "  #\"Removed Columns\" = Table.RemoveColumns(#\"Split Column by Delimiter3\", {\"URL - Copy.1.1.1\", \"URL - Copy.2\"}),",
                "  #\"Added Custom\" = Table.AddColumn(#\"Removed Columns\", \"Custom\", each [URL] & [ID] & \"-\" & [Description]),",
                "  #\"Trimmed Text1\" = Table.TransformColumns(#\"Added Custom\",{{\"ID\", Text.Trim, type text}}),",
                "  #\"Trimmed Text\" = Table.TransformColumns(#\"Trimmed Text1\",{{\"Description\", Text.Trim, type text}}),",
                "  #\"Removed Columns1\" = Table.RemoveColumns(#\"Trimmed Text\", {\"URL - Copy.1.1.2\"}),",
                "  #\"Reordered Columns\" = Table.ReorderColumns(#\"Removed Columns1\", {\"ID\", \"URL - Copy.1.2\", \"Description\", \"Extension\", \"URL\", \"Custom\"}),",
                "  #\"Split Column by Delimiter4\" = Table.SplitColumn(#\"Reordered Columns\", \"URL - Copy.1.2\", Splitter.SplitTextByDelimiter(\".\", QuoteStyle.Csv), {\"URL - Copy.1.2.1\", \"URL - Copy.1.2.2\"}),",
                "  #\"Changed Type\" = Table.TransformColumnTypes(#\"Split Column by Delimiter4\", {{\"URL - Copy.1.2.1\", Int64.Type}, {\"URL - Copy.1.2.2\", type text}}),",
                "  #\"Removed Columns2\" = Table.RemoveColumns(#\"Changed Type\", {\"URL - Copy.1.2.1\"}),",
                "  #\"Renamed Columns1\" = Table.RenameColumns(#\"Removed Columns2\", {{\"URL - Copy.1.2.2\", \"Object\"}}),",
                "    #\"Replaced Value\" = Table.ReplaceValue(#\"Renamed Columns1\",\"SalesQuotes Part 1\",\"SalesQuotes\",Replacer.ReplaceText,{\"Object\"}),",
                "    #\"Replaced Value1\" = Table.ReplaceValue(#\"Replaced Value\",\"SalesQuotes Part 2\",\"SalesQuotes\",Replacer.ReplaceText,{\"Object\"}),",
                "    #\"Replaced Value2\" = Table.ReplaceValue(#\"Replaced Value1\",\"SalesQuotes Part1\",\"SalesQuotes\",Replacer.ReplaceText,{\"Object\"}),",
                "  #\"Trimmed Text2\" = Table.TransformColumns(#\"Replaced Value2\",{{\"Object\", Text.Trim, type text}}),",
                "  #\"Filtered Rows5\" = Table.SelectRows(#\"Trimmed Text2\", each [Object] <> null and [Object] <> \"\"),",
                "  #\"Transform columns\" = Table.TransformColumnTypes(#\"Filtered Rows5\", {{\"Extension\", type text}, {\"URL\", type text}, {\"Custom\", type text}}),",
                "    #\"Removed Columns3\" = Table.RemoveColumns(#\"Transform columns\",{\"Content.1\", \"Attributes\"}),",
                "    #\"Replaced Value3\" = Table.ReplaceValue(#\"Removed Columns3\",\"1 Tasks\",\"Tasks\",Replacer.ReplaceText,{\"Object\"}),",
                "    #\"Replaced Value4\" = Table.ReplaceValue(#\"Replaced Value3\",\"2 SalesQuotes\",\"SalesQuotes\",Replacer.ReplaceText,{\"Object\"})",
                "in",
                "    #\"Replaced Value4\""
              ],
              "type": "m"
            }
          }
