        "measures": [
          {
            "name": "#Activities",
            "expression": [
              "calculate(",
              "    DISTINCTCOUNT(FACT_Activities[ID])",
              "    --countrows(FACT_Activities)",
              "    --FACT_Activities[Document_Type_Text] = \"Activity Task\" && FACT_Activities[Sales_Organization_ID] = \"US20\"",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "a1460284-8734-45d5-ab51-f3c649e83f3e"
          },
          {
            "name": "SelectedActivityID",
            "expression": [
              "",
              "If(",
              "    --HasOneValue(FACT_Activities[ID]),",
              "    ISFiltered(FACT_Activities[ID]),",
              "    1, ",
              "    0",
              ")",
              "",
              ""
            ],
            "formatString": "0",
            "lineageTag": "28c83590-7544-4e71-b36d-0e64449345a3"
          },
          {
            "name": "SelectedActivityID2",
            "expression": [
              "",
              "If(",
              "    HasOneFilter(FACT_Activities[ID_Text]),",
              "    1, ",
              "    0",
              ")",
              ""
            ],
            "formatString": "0",
            "lineageTag": "7b2e0124-9a2a-449f-b170-575f330c674b"
          },
          {
            "name": "SelectedActivityID3",
            "expression": [
              "",
              "If(",
              "    HasOneValue(FACT_Activities[ID])",
              "    || ISFiltered(FACT_Activities[ID]),",
              "    1, ",
              "    0",
              ")",
              "",
              ""
            ],
            "formatString": "0",
            "lineageTag": "b04794cf-4f87-4a35-b6a0-e4fdb8c4e866"
          }
        ],
