            "name": "BridgeAttachmentsActivities",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "  Source = STG_Attachments_ALL,",
                "",
                "  #\"Filtered rows 3\" = Table.SelectRows(Source, each ([Object] = \"Appointments\" or [Object] = \"Emails\" or [Object] = \"Tasks\")),",
                "",
                "  #\"Merged Queries\" = Table.NestedJoin(#\"Filtered rows 3\", {\"ID\"}, FACT_Activities, {\"ID\"}, \"FACT_Activities\", JoinKind.LeftOuter),",
                "",
                "  #\"Expanded FACT_Activities\" = Table.ExpandTableColumn(#\"Merged Queries\", \"FACT_Activities\", {\"Main_Account_ID\", \"Sales_Organization_ID\"}, {\"Account_ID\", \"Sales_Organization_ID\"})",
                "",
                "in",
                "",
                "  #\"Expanded FACT_Activities\""
              ],
              "type": "m"
            }
          }
