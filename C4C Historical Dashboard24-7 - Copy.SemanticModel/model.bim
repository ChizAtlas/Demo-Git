          },
          {
            "name": "Sales_Organization_Name",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "lineageTag": "dfc0873d-faab-4871-945b-c8624b5feb3a",
            "sourceColumn": "Sales_Organization_Name",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "ff37fcd4-15a0-4835-a791-75fedec4c4b7",
        "partitions": [
          {
            "name": "STG BridgeAccountsSalesOrganizations",
            "mode": "import",
            "queryGroup": "Fact_ALL",
            "source": {
              "expression": [
                "let",
                "Source = SharePoint.Contents(\"https://onevirtualoffice.sharepoint.com/sites/bd3f1f870ace457b80c0202621b39b9d/\", [ApiVersion = 15]),",
                "Navigation = Source{[Name = \"C4C SPLIT\"]}[Content],",
                "#\"Navigation 1\" = Navigation{[Name = \"2. Realization\"]}[Content],",
                "#\"Navigation 2\" = #\"Navigation 1\"{[Name = \"2.2 Data exports\"]}[Content],",
                "#\"Navigation 3\" = #\"Navigation 2\"{[Name = \"PT\"]}[Content],",
                "#\"Navigation 4\" = #\"Navigation 3\"{[Name = \"PRODUCTION\"]}[Content],",
                "#\"Removed other columns\" = Table.SelectColumns(#\"Navigation 4\", {\"Content\", \"Name\"}),",
                "#\"Filtered rows\" = Table.SelectRows(#\"Removed other columns\", each ([Name] <> \"0. EMPTY FOLDER STRUCTURE\" and [Name] <> \"0.0 General overviews\" and [Name] <> \"99. OLD\" and [Name] <> \"historical_DB_tasks_related_campaign_ID.xlsx\" and [Name] <> \"Row-Level-Security\" and [Name] <> \"Template_PT_Releases.zip\")),",
                "#\"Expanded Content\" = Table.ExpandTableColumn(#\"Filtered rows\", \"Content\", {\"Content\", \"Name\"}, {\"Content.1\", \"Name.1\"}),",
                " ",
                "#\"Filtered rows 1\" = Table.SelectRows(#\"Expanded Content\", each [Name.1] = \"0. FULL To Start\"),",
                "#\"Expanded Content.1\" = Table.ExpandTableColumn(#\"Filtered rows 1\", \"Content.1\", {\"Content\", \"Name\"}, {\"Content\", \"Name.2\"}),",
                "  ",
                "#\"Extracted tables from Excel binaries\" = Table.AddColumn(#\"Expanded Content.1\", \"Extracted tables\", each Table.PromoteHeaders(",
                "    Excel.Workbook([Content]){[Item=\"sheet1\", Kind=\"Sheet\"]}[Data])),",
                "#\"Removed Errors\" = Table.RemoveRowsWithErrors(#\"Extracted tables from Excel binaries\", {\"Extracted tables\"}),",
                "",
                "#\"Filtered rows 2\" = Table.SelectRows(#\"Removed Errors\", each [Name.2] <> \"Activities Merged.xlsx\" and  Text.Contains([Name.2], \"Accounts_SalesData\")),",
                "",
                "#\"Removed other columns 1\" = Table.SelectColumns(#\"Filtered rows 2\", {\"Extracted tables\"}),",
                "",
                "#\"Expanded Extracted tables\" = Table.ExpandTableColumn(#\"Removed other columns 1\", \"Extracted tables\", ",
                "    {\"Account_ID\", \"Sales_Organization_ID\", \"Sales_Organization_Name\"},",
                "    {\"Account_ID\", \"Sales_Organization_ID\", \"Sales_Organization_Name\"}",
                "),",
                "",
                "//#\"Added Custom\" = ",
                "//        Table.AddColumn(",
                "//            #\"Expanded Extracted tables\", ",
                "//            \"Sales_Organization_ID2\", ",
                "//            each ",
                "//            if Value.Is([Sales_Organization_ID], type list) = true",
                "//            then Text.Combine(List.Transform([Sales_Organization_ID], Text.From), \", \")",
                "//            else [Sales_Organization_ID]",
                "//        ),",
                "",
                "#\"Mark Non Numeric Account IDs\" = Table.AddColumn(#\"Expanded Extracted tables\", \"Account_ID_Error\", ",
                "    each",
                "      if Type.Is(Value.Type([Account_ID]), type number) then [ID_Text]",
                "      else if Text.Contains(Text.Trim([Account_ID]), \" \") then \"DELETE\"",
                "      else try Number.From([Account_ID]) otherwise \"DELETE\"",
                "    ),",
                "#\"Filtered Rows3\" = Table.SelectRows(#\"Mark Non Numeric Account IDs\", each ( [Account_ID_Error] <> \"DELETE\")),",
                "#\"Removed Column4\" = Table.RemoveColumns(#\"Filtered Rows3\",{\"Account_ID_Error\"}),",
                "",
                "//#\"Duplicated Column\" = Table.DuplicateColumn(#\"Removed Column4\", \"Account_ID\", \"Account_ID2\"),",
                "#\"Changed column type\" = Table.TransformColumnTypes(#\"Removed Column4\", {\"Account_ID\", Int64.Type} ),",
                "",
                "#\"Removed Errors1\" = Table.RemoveRowsWithErrors(#\"Changed column type\", {\"Account_ID\"}),",
                "",
                "#\"Removed Duplicates\" = Table.Distinct(#\"Removed Errors1\", {\"Account_ID\", \"Sales_Organization_ID\"})",
                "",
                "in",
                "",
                "#\"Removed Duplicates\""
              ],
              "type": "m"
            }
          }
        ]
      },
