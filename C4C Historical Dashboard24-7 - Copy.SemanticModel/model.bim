            "source": {
              "expression": [
                "let",
                "  Source = BridgeAttachmentsActivities,",
                "    #\"Appended Query\" = Table.Combine({Source, ",
                "      BridgeAttachmentsSalesQuotes, ",
                "      BridgeAttachmentsOpportunities, ",
                "      BridgeAttachmentsLeads,",
                "      BridgeAttachmentsCustomers",
                "    }),",
                "    #\"Replaced Value\" = Table.ReplaceValue(#\"Appended Query\",\"#\",\"%23\",Replacer.ReplaceText,{\"Custom\"})",
                "  in",
                "  #\"Replaced Value\""
              ],
              "type": "m"
            }
          }
        ]
