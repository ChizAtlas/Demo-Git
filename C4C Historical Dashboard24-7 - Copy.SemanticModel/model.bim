        "hierarchies": [
          {
            "name": "Year Hierarchy",
            "levels": [
              {
                "name": "Year",
                "column": "Year",
                "lineageTag": "a6011f30-85f9-4ed8-8749-be35c261475e",
                "ordinal": 0
              },
              {
                "name": "MonthNameLong",
                "column": "MonthNameLong",
                "lineageTag": "f82b269f-1429-42b4-9168-815f3ba2e0c8",
                "ordinal": 1
              },
              {
                "name": "Date",
                "column": "Date",
                "lineageTag": "f78da51f-47a8-4235-ab47-0f9b8f82ab5c",
                "ordinal": 2
              }
            ],
            "lineageTag": "e66977ac-1b09-42de-998b-7312f0a5ef36"
          }
        ],
        "lineageTag": "b13ccec3-a613-4540-817b-172e597ef3ea",
        "partitions": [
          {
            "name": "Date-bc7588ab-ec61-4845-b75c-c4c5e30fa7e3",
            "mode": "import",
            "source": {
              "expression": [
                "",
                "ADDCOLUMNS(",
                "CALENDAR(DATE(YEAR(TODAY())-10,01,01), DATE(YEAR(TODAY())+1, 12,31)),",
                "\"Year\", YEAR([Date]),",
                "\"Monthnumber\", FORMAT ( [Date], \"MM\" ),",
                "\"Quarter\",QUARTER([Date]),",
                "\"Day\", DAY([Date]),",
                "\"MonthNameLong\", FORMAT(DATE(1, MONTH([Date]), 1), \"MMMM\"),",
                "\"MonthNameShort\", FORMAT(DATE(1, MONTH([Date]), 1), \"MMM\"),",
                "\"YearMonth\", YEAR([Date]) & IF( LEN( MONTH([Date])) = 1 , \"0\", \"\") & MONTH([Date])   ,",
                "\"DateInt\", FORMAT ( [Date], \"YYYYMMDD\" ),",
                "\"DayOfWeekNumber\", WEEKDAY ( [Date] ),",
                "\"DayOfWeek\", FORMAT ( [Date], \"ddd\" ),",
                "\"Quarter Q\", \"Q\" & FORMAT ( [Date], \"Q\" ),",
                "\"MonYear\", FORMAT ( [Date], \"mmm\" ) & \" \" & FORMAT ( [Date], \"YYYY\" )",
                ")"
              ],
              "type": "calculated"
            }
          }
        ]
      },
